rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'frontedport@gmail.com' ||
         request.auth.token.email == 'jdnmcuba2016@gmail.com' ||
         request.auth.token.email == 'jdnm2021@gmail.com');
    }

    match /ports/{portId} {
      // Admins see all ports. Regular users see admin ports and their own ports.
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.isAdminPort == true ||
        !('userId' in resource.data) ||
        resource.data.userId == '' ||
        resource.data.userId == request.auth.uid
      );

      // Create: Admins can create admin ports. Regular users can create their own private ports.
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.isAdminPort != true)
      );

      // Update / Delete: Admins can update/delete any port.
      // Regular users can only update/delete ports that belong to them (cannot edit or delete admin ports).
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && resource.data.isAdminPort != true)
      );

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      }
    }
  }
}

